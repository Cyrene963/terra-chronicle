<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Terra Chronicle · 大地编年史 v9.7</title>
<link rel="icon" href="data:,">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preload" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Noto+Serif+SC:wght@300;500;700&display=swap" as="style">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Noto+Serif+SC:wght@300;500;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="src/panel-system.css?v=94">
<style>
  :root{
    --ink:#2b2722; --ivory:#f6f1e7; --gold:#c9a24b; --gold-soft:rgba(201,162,75,.55);
    --hairline:rgba(43,39,34,.18);
  }
  *{margin:0;padding:0;box-sizing:border-box}
  html,body{height:100%;overflow:hidden;background:#0d0f12;font-family:'Noto Serif SC',serif;color:var(--ink);
    -webkit-user-select:none;user-select:none;-webkit-tap-highlight-color:transparent;overscroll-behavior:none}
  canvas{display:block;touch-action:none;width:100%;height:100%}
  #stage{position:fixed;inset:0;z-index:10}

  /* Loading overlay (hides until first frame ready) */
  #loading{position:fixed;inset:0;z-index:999;background:#0a0a0e;
    display:flex;align-items:center;justify-content:center;
    transition:opacity .6s cubic-bezier(.4,0,.2,1);pointer-events:none;}
  #loading.ready{opacity:0;}

  /* ---------- 标题界面 ---------- */
  #title{
    position:fixed;inset:0;z-index:40;display:flex;align-items:center;justify-content:center;
    overflow:hidden;transition:opacity 2.2s cubic-bezier(.65,0,.35,1);
  }
  #title .bg{
    position:absolute;inset:-6%;
    background:url('assets/concept/kv_continent.png?v=26') center/cover;
    animation:kvBreath 26s ease-in-out infinite alternate;
    filter:saturate(1.04);
  }
  @keyframes kvBreath{from{transform:scale(1) translateY(0)}to{transform:scale(1.07) translateY(-1.4%)}}
  #title .veil{position:absolute;inset:0;background:
    radial-gradient(ellipse at 50% 42%,rgba(8,10,14,0) 30%,rgba(8,10,14,.55) 100%),
    linear-gradient(rgba(8,10,14,.18),rgba(8,10,14,.34));}
  #title .card{position:relative;text-align:center;color:var(--ivory);transform:translateY(-2vh)}
  #title .epoch{
    font-family:'Cormorant Garamond',serif;letter-spacing:.55em;font-size:13px;opacity:0;
    text-transform:uppercase;animation:riseIn 1.6s .4s cubic-bezier(.2,.8,.2,1) forwards;
  }
  #title h1{
    font-weight:300;font-size:clamp(44px,7vw,92px);letter-spacing:.18em;margin:18px 0 6px;
    opacity:0;animation:riseIn 1.8s .8s cubic-bezier(.2,.8,.2,1) forwards;
    text-shadow:0 2px 40px rgba(0,0,0,.45);
  }
  #title h2{
    font-family:'Cormorant Garamond',serif;font-style:italic;font-weight:400;
    font-size:clamp(15px,1.6vw,21px);letter-spacing:.3em;opacity:0;
    animation:riseIn 1.8s 1.15s cubic-bezier(.2,.8,.2,1) forwards;
  }
  #title .rule{
    width:0;height:1px;background:linear-gradient(90deg,transparent,var(--gold-soft),transparent);
    margin:34px auto;animation:ruleGrow 1.6s 1.5s cubic-bezier(.65,0,.35,1) forwards;
  }
  @keyframes ruleGrow{to{width:min(420px,46vw)}}
  @keyframes riseIn{from{opacity:0;transform:translateY(26px)}to{opacity:1;transform:none}}
  #enter{
    opacity:0;animation:riseIn 1.6s 1.9s cubic-bezier(.2,.8,.2,1) forwards;
    background:none;border:1px solid rgba(246,241,231,.4);color:var(--ivory);
    font-family:'Noto Serif SC',serif;font-weight:300;letter-spacing:.5em;text-indent:.5em;
    font-size:15px;padding:15px 52px;cursor:pointer;position:relative;overflow:hidden;
    transition:border-color .6s,color .6s;
  }
  #enter::before{
    content:'';position:absolute;inset:0;background:var(--ivory);transform:scaleX(0);
    transform-origin:left;transition:transform .55s cubic-bezier(.65,0,.35,1);z-index:-1;
  }
  #enter:hover{color:var(--ink);border-color:var(--ivory)}
  #enter:hover::before{transform:scaleX(1)}
  #title .hint{margin-top:26px;font-size:11px;letter-spacing:.35em;opacity:0;
    animation:riseIn 1.6s 2.3s forwards;color:rgba(246,241,231,.55)}
  #clouds{position:fixed;inset:0;z-index:55;pointer-events:none;opacity:0}

  /* ---------- HUD ---------- */
  #hud{position:fixed;inset:0;z-index:30;pointer-events:none;opacity:0;transition:opacity 1.8s 1s}
  .hud-on #hud{opacity:1}

  #seasonDial{position:absolute;top:34px;left:38px;width:108px;height:108px}
  #seasonDial svg{width:100%;height:100%;overflow:visible}
  #dialLabel{
    position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;
    color:var(--ivory);text-shadow:0 1px 14px rgba(0,0,0,.5);
  }
  #dialLabel .s{font-size:19px;font-weight:500;letter-spacing:.32em;text-indent:.32em}
  #dialLabel .d{font-family:'Cormorant Garamond',serif;font-size:11px;letter-spacing:.28em;margin-top:4px;opacity:.78}
  #clock{position:absolute;top:46px;left:170px;color:var(--ivory);text-shadow:0 1px 12px rgba(0,0,0,.45)}
  #clock .num{font-family:'Cormorant Garamond',serif;font-size:34px;font-weight:400;line-height:1}
  #clock .cap{font-size:10px;letter-spacing:.42em;opacity:.7;margin-top:6px}
  #stamina{position:absolute;top:40px;right:42px;display:flex;gap:9px;align-items:center}
  #stamina .leaf{width:13px;height:13px;border-radius:60% 0 60% 0;background:var(--ivory);
    opacity:.92;box-shadow:0 1px 10px rgba(0,0,0,.35);transform:rotate(45deg);transition:opacity .5s}
  #stamina .leaf.spent{opacity:.22}
  #weatherTag{
    position:absolute;left:34px;bottom:120px;color:rgba(246,241,231,.8);
    font-family:'Cormorant Garamond',serif;font-style:italic;font-size:14px;letter-spacing:.2em;
    text-shadow:0 1px 12px rgba(0,0,0,.5);
  }
  #perfBadge{position:absolute;right:42px;top:40px;color:rgba(246,241,231,.72);font-family:'Cormorant Garamond',serif;
    font-size:12px;letter-spacing:.18em;text-shadow:0 1px 12px rgba(0,0,0,.55);text-align:right;}
  #perfBadge b{font-size:20px;color:#f6f1e7;font-weight:400;}
  #whisper{
    position:absolute;bottom:130px;left:50%;transform:translateX(-50%);
    color:rgba(246,241,231,.82);font-weight:300;font-size:13px;letter-spacing:.3em;text-indent:.3em;
    text-shadow:0 1px 16px rgba(0,0,0,.55);opacity:0;transition:opacity 2s;white-space:nowrap;
  }

  /* 背包 Dock 与交互提示 */
  #dock{
    position:absolute;bottom:32px;left:50%;transform:translateX(-50%);
    display:flex;gap:24px;align-items:center;pointer-events:auto;
    background:rgba(246,241,231,.9);backdrop-filter:blur(14px) saturate(1.1);
    border:1px solid var(--hairline);border-radius:999px;padding:11px 13px 11px 28px;
    box-shadow:0 16px 44px rgba(10,10,10,.3);font-size:13px;letter-spacing:.14em;color:var(--ink);
  }
  #dock .item{display:flex;align-items:center;gap:6px;position:relative;}
  #dock .item .resource-icon{width:18px;height:18px;flex:none;filter:drop-shadow(0 1px 3px rgba(0,0,0,.25));}
  #dock .item .resource-num{font-family:'Cormorant Garamond',serif;font-size:19px;font-weight:600;color:var(--ink);position:relative;display:inline-block;}
  #dock .item .resource-num .delta{position:absolute;left:50%;top:-8px;transform:translateX(-50%);font-size:13px;color:var(--gold);animation:deltaFloat 800ms ease-out forwards;pointer-events:none;z-index:10;}
  @keyframes deltaFloat{to{opacity:0;transform:translate(-50%,-20px);}}
  #dock .item .resource-num.milestone{animation:milestone 400ms cubic-bezier(.34,1.56,.64,1);}
  @keyframes milestone{50%{transform:scale(1.15);}}
  #dock .sep{width:1px;height:18px;background:var(--hairline)}
  /* 炼金FAB悬浮按钮 */
  #craftFAB{
    position:fixed;right:42px;bottom:130px;width:64px;height:64px;border-radius:50%;z-index:35;
    background:radial-gradient(circle at 35% 30%,#f4d03f,#c9a24b 62%,#8a6d2c);
    border:2px solid rgba(255,236,174,.75);box-shadow:0 12px 34px rgba(201,162,75,.42),0 0 28px rgba(244,208,63,.35);
    cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:32px;
    transition:transform .35s cubic-bezier(.34,1.56,.64,1),box-shadow .35s;
    animation:fabPulse 1.6s ease-in-out infinite;pointer-events:auto;
  }
  #craftFAB::before{content:'⚗';color:#2b2417;text-shadow:0 2px 8px rgba(0,0,0,.25);}
  #craftFAB:hover{transform:translateY(-6px) scale(1.08);box-shadow:0 18px 48px rgba(201,162,75,.52),0 0 38px rgba(244,208,63,.48);}
  @keyframes fabPulse{0%,100%{box-shadow:0 12px 34px rgba(201,162,75,.42),0 0 28px rgba(244,208,63,.35)}50%{box-shadow:0 12px 34px rgba(201,162,75,.52),0 0 38px rgba(244,208,63,.52)}}

  #craftBtn{
    border:1px solid var(--gold);background:none;color:var(--ink);cursor:pointer;
    font-family:'Noto Serif SC',serif;font-size:12px;letter-spacing:.3em;text-indent:.3em;
    padding:9px 20px;border-radius:999px;position:relative;overflow:hidden;
    transition:color .45s,opacity .3s;z-index:0;display:none;
  }
  #craftBtn::before{content:'';position:absolute;inset:0;background:var(--gold);
    transform:scaleX(0);transform-origin:left;transition:transform .45s cubic-bezier(.65,0,.35,1);z-index:-1}
  #craftBtn:not(:disabled):hover{color:#fff}
  #craftBtn:not(:disabled):hover::before{transform:scaleX(1)}
  #craftBtn:disabled{opacity:.35;cursor:not-allowed;pointer-events:none}
  #hintAction{
    position:absolute;bottom:92px;left:50%;transform:translateX(-50%);
    color:var(--ivory);font-size:12px;letter-spacing:.4em;text-indent:.4em;
    text-shadow:0 1px 14px rgba(0,0,0,.6);opacity:0;transition:opacity .4s;white-space:nowrap;
  }
  #hintAction .key{display:inline-block;border:1px solid rgba(246,241,231,.6);border-radius:4px;
    padding:1px 7px;margin-right:10px;font-size:11px;letter-spacing:.1em;text-indent:0}

  /* 灵兽管理迷你面板(左下) */
  #beastPanel{
    position:absolute;left:30px;bottom:32px;display:flex;align-items:center;gap:13px;pointer-events:auto;
    background:rgba(246,241,231,.9);backdrop-filter:blur(14px) saturate(1.1);
    border:1px solid var(--hairline);border-radius:16px;padding:11px 20px 11px 12px;
    box-shadow:0 14px 40px rgba(10,10,10,.28);
  }
  #beastPanel .portrait{
    width:46px;height:46px;border-radius:12px;flex:none;
    background:radial-gradient(circle at 50% 38%,#bfeaf2,#7fc6dc);
    background-image:url('assets/sprites/beast_water.png');background-size:130%;background-position:center 30%;
    box-shadow:inset 0 0 0 1px rgba(255,255,255,.5);
  }
  #beastPanel .meta .nm{font-size:13px;letter-spacing:.22em;font-weight:500}
  #beastPanel .meta .st{font-family:'Cormorant Garamond',serif;font-style:italic;font-size:13px;
    letter-spacing:.1em;color:var(--gold);margin-top:3px}
  #beastPanel{cursor:pointer;transition:transform .22s,box-shadow .22s}
  #beastPanel:hover{transform:translateY(-2px);box-shadow:0 18px 48px rgba(10,10,10,.34),0 0 20px rgba(127,198,220,.22)}
  #petCodex{position:fixed;left:30px;bottom:112px;width:min(420px,calc(100vw - 60px));z-index:42;pointer-events:none;opacity:0;transform:translateY(12px) scale(.98);transition:opacity .24s,transform .24s;background:rgba(246,241,231,.94);backdrop-filter:blur(16px) saturate(1.12);border:1px solid rgba(139,115,85,.28);border-radius:18px;box-shadow:0 22px 60px rgba(10,10,10,.34);padding:18px;color:var(--ink)}
  #petCodex.on{opacity:1;transform:translateY(0) scale(1);pointer-events:auto}
  #petCodex .hd{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;font-family:'Cormorant Garamond',serif;color:var(--gold);letter-spacing:.24em;text-transform:uppercase;font-size:11px}
  #petCodex .close{cursor:pointer;font-size:18px;letter-spacing:0;color:var(--ink);opacity:.55}
  #petCodex .pet{display:grid;grid-template-columns:48px 1fr;gap:12px;padding:11px 0;border-top:1px solid rgba(139,115,85,.16)}
  #petCodex .pet:first-of-type{border-top:0}
  #petCodex .pet img{width:48px;height:48px;object-fit:contain;filter:drop-shadow(0 7px 10px rgba(20,30,34,.24))}
  #petCodex .pet b{font-size:13px;letter-spacing:.18em;font-weight:600}
  #petCodex .pet .role{font-size:10px;letter-spacing:.12em;color:var(--gold);margin-top:3px}
  #petCodex .pet .skill{font-size:10px;line-height:1.65;opacity:.7;margin-top:5px}
  #petCodex .petUse{margin-top:8px;border:1px solid rgba(143,109,66,.45);background:rgba(255,255,255,.3);border-radius:999px;padding:5px 10px;font-size:10px;letter-spacing:.16em;color:var(--ink);cursor:pointer}
  #petCodex .petUse:hover{background:var(--gold);color:white}

  #ecoPanel{
    position:absolute;right:42px;top:108px;width:218px;pointer-events:auto;
    background:rgba(246,241,231,.88);backdrop-filter:blur(14px) saturate(1.08);
    border:1px solid rgba(43,39,34,.16);border-radius:18px;padding:14px 16px 15px;
    box-shadow:0 18px 48px rgba(10,10,10,.24);color:var(--ink);
  }
  #ecoPanel .k{font-family:'Cormorant Garamond',serif;text-transform:uppercase;letter-spacing:.34em;font-size:10px;color:var(--gold);}
  #ecoPanel .main{display:flex;justify-content:space-between;align-items:baseline;margin:7px 0 10px;}
  #ecoPanel .main b{font-size:15px;letter-spacing:.18em;font-weight:600;}
  #ecoPanel .main span{font-family:'Cormorant Garamond',serif;font-size:24px;color:var(--gold);}
  #ecoPanel .bar{height:3px;background:rgba(43,39,34,.13);border-radius:99px;overflow:hidden;}
  #ecoPanel .bar i{display:block;height:100%;transform-origin:left;transform:scaleX(.7);background:linear-gradient(90deg,#8f6d42,#c9a24b,#8fc58b);transition:transform .8s cubic-bezier(.2,.8,.2,1),background .8s;}
  #ecoPanel .sub{margin-top:9px;font-size:10px;letter-spacing:.16em;line-height:1.75;opacity:.68;}
  #ecoPanel.warn .bar i{background:linear-gradient(90deg,#7a3b31,#d08b45,#f0c66c)}
  #ecoPanel.danger .bar i{background:linear-gradient(90deg,#5b2325,#a74337,#d46b4f)}

  /* 锻造卡牌揭示 */
  #cardReveal{
    position:fixed;inset:0;z-index:120;display:flex;flex-direction:column;gap:22px;
    align-items:center;justify-content:center;background:radial-gradient(circle at 50% 38%,rgba(244,208,63,.18),transparent 34%),rgba(8,10,14,.72);backdrop-filter:blur(8px) saturate(1.1);
    opacity:0;pointer-events:none;transition:opacity .6s;
  }
  #cardReveal.on{opacity:1;pointer-events:auto}
  #cardReveal .stage3d{perspective:1100px;position:relative}
  #cardReveal .stage3d::before{content:'工坊炼成';position:absolute;left:50%;top:-54px;transform:translateX(-50%);font-family:'Noto Serif SC',serif;font-size:13px;letter-spacing:.5em;text-indent:.5em;color:rgba(246,241,231,.7);white-space:nowrap;}
  #cardReveal .cardBox{
    width:min(310px,66vw);aspect-ratio:2/3;position:relative;
    transform:rotateY(180deg) translateY(30px) scale(.78);
    transform-style:preserve-3d;transition:transform 1.05s cubic-bezier(.2,.85,.25,1);
    filter:drop-shadow(0 36px 70px rgba(0,0,0,.66));
  }
  #cardReveal.on .cardBox{transform:rotateY(0) translateY(0) scale(1)}
  #cardReveal .face{
    position:absolute;inset:0;border-radius:18px;backface-visibility:hidden;overflow:hidden;
    background:linear-gradient(180deg,rgba(255,248,221,.96),rgba(207,171,101,.9));border:1px solid rgba(244,208,63,.68);box-shadow:inset 0 0 0 7px rgba(76,45,21,.18),inset 0 0 0 10px rgba(255,255,255,.18);
  }
  #cardReveal .face::before{content:'';position:absolute;inset:13px;border:1px solid rgba(84,49,21,.26);border-radius:12px;z-index:3;pointer-events:none;}
  #cardReveal .face.back{transform:rotateY(180deg);filter:brightness(.46) saturate(.7);background:url('assets/concept/card_template.png') center/cover;}
  #cardReveal .cardArt{position:absolute;left:36px;right:36px;top:72px;height:172px;border-radius:18px;display:grid;place-items:center;background:radial-gradient(circle at 50% 40%,rgba(255,255,255,.42),rgba(107,74,34,.18));box-shadow:inset 0 0 0 1px rgba(91,56,25,.22),0 12px 30px rgba(0,0,0,.18);z-index:1;overflow:hidden;}
  #cardReveal .cardArt img{width:76%;height:76%;object-fit:contain;filter:drop-shadow(0 12px 20px rgba(0,0,0,.25));}
  #cardReveal .overlayTxt{
    position:absolute;left:18px;right:18px;bottom:18px;border-radius:16px;
    background:linear-gradient(180deg,rgba(49,31,19,.9),rgba(18,12,10,.94));border:1px solid rgba(244,208,63,.25);
    padding:18px 16px 15px;text-align:center;color:var(--ivory);z-index:2;box-shadow:0 12px 26px rgba(0,0,0,.25);
  }
  #cardReveal .cname{font-size:23px;font-weight:700;letter-spacing:.22em;text-indent:.22em;color:#fff0c8}
  #cardReveal .cstats{font-family:'Noto Serif SC',serif;font-size:14px;margin-top:8px;letter-spacing:.12em}
  #cardReveal .cstats b{color:var(--gold);font-size:19px;font-family:'Cormorant Garamond',serif}
  #cardReveal .caffix{font-size:11px;letter-spacing:.13em;opacity:.88;margin-top:8px;line-height:1.75}
  #cardReveal .closeHint{color:rgba(246,241,231,.68);font-size:11px;letter-spacing:.42em;text-indent:.42em}

  /* 核心交互点呼吸光环 */
  .interaction-glow{
    position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);
    width:140%;height:140%;border-radius:50%;pointer-events:none;z-index:-1;
    background:radial-gradient(circle,rgba(201,162,75,.45) 0%,rgba(201,162,75,.22) 42%,transparent 68%);
    animation:interactionPulse 0.8s ease-in-out infinite alternate;
  }
  @keyframes interactionPulse{from{transform:translate(-50%,-50%) scale(1);opacity:.85}to{transform:translate(-50%,-50%) scale(1.12);opacity:1}}

  /* 地块面板（毛玻璃,弹簧动效由 JS 驱动） */
  #panel{
    position:absolute;top:0;right:0;height:100%;width:min(360px,86vw);
    background:rgba(246,241,231,.92);backdrop-filter:blur(14px) saturate(1.1);
    border-left:1px solid var(--hairline);padding:54px 38px;pointer-events:auto;
    transform:translateX(110%);box-shadow:-30px 0 80px rgba(10,10,10,.18);
  }
  #panel .kicker{font-family:'Cormorant Garamond',serif;font-size:11px;letter-spacing:.5em;color:var(--gold);text-transform:uppercase}
  #panel h3{font-size:27px;font-weight:500;letter-spacing:.14em;margin:10px 0 4px}
  #panel .latin{font-family:'Cormorant Garamond',serif;font-style:italic;font-size:14px;opacity:.55;margin-bottom:30px}
  #panel .close{position:absolute;top:26px;right:28px;width:30px;height:30px;cursor:pointer;opacity:.55;transition:opacity .3s,transform .5s cubic-bezier(.2,.8,.2,1)}
  #panel .close:hover{opacity:1;transform:rotate(90deg)}
  #panel .close::before,#panel .close::after{content:'';position:absolute;top:14px;left:4px;width:22px;height:1px;background:var(--ink)}
  #panel .close::before{transform:rotate(45deg)}#panel .close::after{transform:rotate(-45deg)}
  .stat{margin-bottom:24px}
  .stat .row{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:9px}
  .stat .name{font-size:13px;letter-spacing:.26em}
  .stat .val{font-family:'Cormorant Garamond',serif;font-size:21px}
  .stat .bar{height:2px;background:rgba(43,39,34,.12);position:relative;overflow:hidden}
  .stat .bar i{position:absolute;inset:0;transform-origin:left;background:var(--ink);transform:scaleX(0)}
  .stat.gold .bar i{background:var(--gold)}
  #panel .foot{position:absolute;bottom:44px;left:38px;right:38px;font-size:11px;
    letter-spacing:.18em;line-height:2.1;opacity:.6;border-top:1px solid var(--hairline);padding-top:20px}

  #cardPeek{
    position:absolute;right:44px;bottom:40px;width:118px;aspect-ratio:2/3;pointer-events:auto;
    perspective:700px;cursor:pointer;filter:drop-shadow(0 18px 30px rgba(0,0,0,.45));
    transition:transform .7s cubic-bezier(.2,.8,.2,1);
  }
  #cardPeek:hover{transform:translateY(-42px) scale(1.15) rotateY(2deg);filter:drop-shadow(0 28px 48px rgba(0,0,0,.58)) drop-shadow(0 0 32px rgba(201,162,75,.32))}
  #cardPeek .face{
    width:100%;height:100%;border-radius:7px;background:url('assets/concept/card_template.png') center/cover;
    transition:transform .25s ease-out;will-change:transform;
  }
  #cardPeek .tag{
    position:absolute;bottom:-26px;left:0;right:0;text-align:center;color:rgba(246,241,231,.7);
    font-size:10px;letter-spacing:.4em;text-indent:.4em;
  }
</style>
</head>
<body>

<div id="stage"></div>

<div id="hud">
  <div id="seasonDial">
    <svg viewBox="0 0 108 108">
      <circle cx="54" cy="54" r="50" fill="rgba(10,12,14,.28)" stroke="rgba(246,241,231,.28)" stroke-width="1"/>
      <g id="dialRing"></g>
      <circle id="dialDot" cx="54" cy="4" r="2.6" fill="#f6f1e7"/>
    </svg>
    <div id="dialLabel"><div class="s" id="seasonName">春</div><div class="d" id="seasonLatin">VER</div></div>
  </div>
  <div id="clock"><div class="num"><span id="dayNum">01</span></div><div class="cap">年代 I · 第一年</div></div>
  <div id="stamina"></div>
  <div id="perfBadge"><b id="fpsVal">—</b> FPS<br><span id="qualityVal">AUTO</span></div>
  <div id="weatherTag">— 微风拂过山谷 —</div>

  <div id="panel">
    <div class="close" id="panelClose"></div>
    <div class="kicker">Parcel · 地籍档案</div>
    <h3 id="tileName">河畔田</h3>
    <div class="latin" id="tileLatin">Ager Fluminis</div>
    <div class="stat"><div class="row"><span class="name">肥 力</span><span class="val" id="vFert">—</span></div><div class="bar"><i id="bFert"></i></div></div>
    <div class="stat"><div class="row"><span class="name">湿 度</span><span class="val" id="vMoist">—</span></div><div class="bar"><i id="bMoist"></i></div></div>
    <div class="stat"><div class="row"><span class="name">虫害压力</span><span class="val" id="vPest">—</span></div><div class="bar"><i id="bPest"></i></div></div>
    <div class="stat gold"><div class="row"><span class="name">灵脉充能</span><span class="val" id="vMana">—</span></div><div class="bar"><i id="bMana"></i></div></div>
    <div class="foot">此地块产出的材料将继承土地质量。<br>肥力越高，锻造出的卡牌基础数值越高。</div>
  </div>

  <div id="cardPeek"><div class="face"></div><div class="tag">工坊 · 待锻</div></div>
  <div id="craftFAB" data-testid="craft-fab"></div>
  <div id="whisper">点击大地行走 · 走近树木自动伐木 · 点击耕地耕种 · 1-4 季节 · F 加速</div>
  <div id="hintAction"><span class="key">空格</span><span id="hintTxt">播种</span></div>
  <div id="beastPanel">
    <div class="portrait"></div>
    <div class="meta"><div class="nm" id="beastName">水灵兽 · 未名</div><div class="st" id="beastState">闲逛中 …</div></div>
  </div>
  <div id="petCodex"><div class="hd">Companion Codex · 精选灵兽 <span class="close" id="petCodexClose">×</span></div><div id="petCodexList"></div></div>
  <div id="ecoPanel">
    <div class="k">Ecology · 生态</div>
    <div class="main"><b id="ecoStatus">平衡</b><span id="ecoScore">72</span></div>
    <div class="bar"><i id="ecoBar"></i></div>
    <div class="sub" id="ecoDetail">虫害低 · 水灵兽巡田 · 土壤稳定</div>
  </div>
  <div id="dock" data-testid="game-dock">
    <span class="item" data-testid="wheat-counter">
      <svg class="resource-icon" viewBox="0 0 18 18"><path d="M9 2 L9 16 M6 6 Q6 4 9 4 Q12 4 12 6 M6 10 Q6 8 9 8 Q12 8 12 10 M6 14 Q6 12 9 12 Q12 12 12 14" stroke="#d4a574" stroke-width="1.2" fill="none"/></svg>
      星麦<span class="resource-num" id="invWheat" data-value="0">0</span>
    </span>
    <span class="sep"></span>
    <span class="item" data-testid="wood-counter">
      <svg class="resource-icon" viewBox="0 0 18 18"><rect x="7" y="2" width="4" height="14" rx="1" fill="#8b6d42" stroke="#d4a574" stroke-width="0.8"/><circle cx="6" cy="6" r="2.5" fill="none" stroke="#d4a574" stroke-width="1"/><circle cx="12" cy="8" r="3" fill="none" stroke="#d4a574" stroke-width="1"/></svg>
      木材<span class="resource-num" id="invWood" data-value="0">0</span>
    </span>
    <span class="sep"></span>
    <span class="item" data-testid="card-counter">
      <svg class="resource-icon" viewBox="0 0 18 18"><rect x="3" y="4" width="12" height="10" rx="1.5" fill="rgba(212,165,116,.3)" stroke="#d4a574" stroke-width="1.2"/><line x1="6" y1="7" x2="12" y2="7" stroke="#d4a574" stroke-width="0.8"/><line x1="6" y1="9.5" x2="12" y2="9.5" stroke="#d4a574" stroke-width="0.8"/><line x1="6" y1="12" x2="10" y2="12" stroke="#d4a574" stroke-width="0.8"/></svg>
      卡牌<span class="resource-num" id="invCards" data-value="0">0</span>
    </span>
  </div>
</div>

<div id="cardReveal">
  <div class="stage3d"><div class="cardBox">
    <div class="face front">
      <div class="cardArt"><img id="cvArt" src="assets/sprites/card_art_guard.png" alt=""></div>
      <div class="overlayTxt">
        <div class="cname" id="cvName">新芽守卫</div>
        <div class="cstats">攻 <b id="cvAtk">—</b> · 防 <b id="cvDef">—</b> · 产地 <b id="cvQ">—</b></div>
        <div class="caffix" id="cvAffix"></div>
      </div>
    </div>
    <div class="face back"></div>
  </div></div>
  <div class="closeHint">点击任意处收入卡组</div>
</div>

<div id="title">
  <div class="bg"></div><div class="veil"></div>
  <div class="card">
    <div class="epoch">Epoch I · The First Continent</div>
    <h1>大地编年史</h1>
    <h2>TERRA CHRONICLE</h2>
    <div class="rule"></div>
    <button id="enter" data-testid="enter-game-button">踏 上 大 陆</button>
    <div class="hint">这一次，亲自走在大地上</div>
  </div>
</div>
<canvas id="clouds"></canvas>

<!-- Loading overlay (fades out when game ready) -->
<div id="loading"></div>

<script src="vendor/pixi.min.js"></script>
<script src="src/state.js?v=8"></script>
<script src="src/game_feel_enhanced.js?v=1"></script>
<script src="src/feedback_system.js?v=1"></script>
<script src="src/alchemy.js?v=46"></script>
<script src="src/battle.js?v=63"></script>
<script src="src/dungeon.js?v=50"></script>
<script src="src/upgrade.js?v=37"></script>
<script src="src/main.js?v=68"></script>
</body>
</html>
